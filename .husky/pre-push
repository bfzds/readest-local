# 推送前四道关：先脱敏（最便宜，也最该先失败），再格式 / 静态检查 / 测试。
# 不得用 --no-verify 绕过（见 docs/git-setup.md 与 AGENTS.md）。
if ! bash scripts/desensitize-check.sh; then
  echo '[pre-push] 脱敏检查未通过（或无法执行），已拦下本次推送。' >&2
  exit 1
fi
pnpm -C apps/readest-app format:check
pnpm -C apps/readest-app lint
pnpm -C apps/readest-app test
